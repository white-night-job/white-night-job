# 本番サイトURL（OGP・構造化データ用）
NEXT_PUBLIC_SITE_URL=https://www.whitenightjob.jp

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SHOP_IMAGE_BUCKET=shop-images
# 掲載審査の身分証明書専用（非公開）。未設定時は listing-application-identity
# SUPABASE_LISTING_APPLICATION_IDENTITY_BUCKET=listing-application-identity

# /admin の簡易ログイン用
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-long-random-secret

# ブラック店報告の通知メール（Resend 優先）
# 本番 Vercel にも同名で設定すること（未設定だと申請通知メールは送られない）
RESEND_API_KEY=re_xxxxxxxx
REPORT_EMAIL=whitenightjob.info@gmail.com
# 任意: REPORT_EMAIL の代わりに使える運営通知先
# ADMIN_NOTIFY_EMAIL=whitenightjob.info@gmail.com
# Resend で検証済みドメインの From（必須。resend.dev は使わない）
RESEND_FROM_EMAIL=White Night Job <info@whitenightjob.jp>

# Resend 未設定時の Nodemailer フォールバック（任意）
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=White Night Job <your-smtp-user>

# White Night相談Bot（OpenAI API）
OPENAI_API_KEY=sk-xxxxxxxx

# 求職者向けLINEログイン / 通知
LINE_LOGIN_CHANNEL_ID=2000000000
LINE_LOGIN_CHANNEL_SECRET=your-line-login-channel-secret
# 本番: https://www.whitenightjob.jp/api/auth/line/callback
# ローカル: http://localhost:3000/api/auth/line/callback
# ※末尾に改行を入れないこと（Vercel環境変数で %0A が付くとLINE認証が失敗します）
LINE_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/line/callback
# 公式アカウント友だち追加促進（normal / aggressive）。未設定時は aggressive
# LINE_LOGIN_BOT_PROMPT=aggressive
# 友だち追加必須ログイン用（Basic ID。例: @358cnyan）
LINE_OFFICIAL_ACCOUNT_ID=@358cnyan
# LIFF ID（LINE Developers の LIFF アプリで発行。未設定時は既存 Web LINE Login へフォールバック）
# Endpoint URL: https://www.whitenightjob.jp/auth/line/liff
NEXT_PUBLIC_LIFF_ID=2010646670-HdI31jKc
# LINE Messaging / Cron
# Push送信用（Messaging API）。LINE_CHANNEL_ACCESS_TOKEN でも可（後方互換）
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=your-line-messaging-channel-access-token
LINE_MESSAGING_CHANNEL_SECRET=your-line-messaging-channel-secret
# Vercel Cron 認証（/api/cron/*）。未設定だと Cron は 401 になります
# Vercel は Authorization: Bearer $CRON_SECRET を自動付与します
CRON_SECRET=change-this-long-random-cron-secret
# 1 または true で毎日PickUp配信を dry-run（実際のLINE送信なし）
# LINE_DAILY_PICKUP_DRY_RUN=1
USER_SESSION_SECRET=change-this-user-session-secret
# www/apex 両方でCookie共有が必要な場合のみ設定（例: .whitenightjob.jp）
# COOKIE_DOMAIN=.whitenightjob.jp
