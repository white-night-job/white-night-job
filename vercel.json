{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.whitenightjob.jp" }],
      "destination": "https://whitenightjob.jp/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/line-daily-pickup",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/cleanup-temp-images",
      "schedule": "0 3 * * *"
    }
  ]
}
